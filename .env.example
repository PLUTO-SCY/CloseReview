# Copy this file to .env.local and fill in your OpenReview credentials.
# Do not commit or paste the real values into chat.
OPENREVIEW_USERNAME=
OPENREVIEW_PASSWORD=
OPENREVIEW_API_VERSION=auto

# Optional: LLM-assisted paper analysis chat.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_REASONING_EFFORT=high

# Copy this file to .env.local and fill in your OpenReview credentials.
# Do not commit or paste the real values into chat.
OPENREVIEW_USERNAME=
OPENREVIEW_PASSWORD=
OPENREVIEW_API_VERSION=auto

# Optional: future LLM-assisted review cleanup. The app does not require this
# for rule-based official-review extraction.
DEEPSEEK_API_KEY=
